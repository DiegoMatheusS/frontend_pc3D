# Base onde os modelos/recursos 3D legados ainda são servidos em desenvolvimento.
VITE_LEGACY_BASE_URL=http://127.0.0.1:5500/

# Em desenvolvimento, o Vite encaminha /api para o NestJS.
VITE_DEV_API_TARGET=http://localhost:3000

# Deixe vazio quando frontend e API usam o mesmo domínio ou o proxy do Vite.
# Em produção separada, informe a origem pública do backend, sem barra final.
# VITE_API_BASE_URL=https://api.exemplo.com

# Fonte de dados do catálogo:
# api  = recomendado para produção; nunca substitui falha por preço/produto demonstrativo
# auto = útil durante desenvolvimento; tenta API e pode usar dados locais de demonstração
# mock = usa somente dados locais
VITE_DATA_MODE=api

# Opcional. O backend final usa /api/auth/cadastro.
# Só altere se o deploy expuser essa mesma rota por outro caminho.
# VITE_REGISTER_ENDPOINT=/api/auth/cadastro


# Opcional: e-mail usado pela página Contato para abrir o aplicativo de e-mail do visitante.
# VITE_CONTACT_EMAIL=contato@seudominio.com.br
