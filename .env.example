# URL do backend. Em produção pode ficar vazio se /api usar o mesmo domínio/proxy.
VITE_API_BASE_URL=https://api.criabyte.com.br

# Use api para nunca cair em dados demonstrativos.
VITE_DATA_MODE=api

# Client ID público do Google Identity Services. Deve corresponder ao GOOGLE_CLIENT_ID do backend.
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# Assets do montador 3D servidos pelo próprio frontend.
VITE_LEGACY_BASE_URL=/legacy-builder/
